<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets the app appear in "Display over other apps" and be granted it (SPEC §2.4). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Install-granted (sideloaded app): lets ScheduleAlarmScheduler use
         setExactAndAllowWhileIdle for schedule boundary flips (SPEC §2.3). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Guided node capture: progress and "Stop now" live in a notification. Denial is handled
         in-app (step card); the capture itself still works. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Guided capture launches the target app for the user (package visibility, API 30+). -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
    </queries>

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreeSocial">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.BlockActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FreeSocial.Block" />

        <service
            android:name=".filter.FilterService"
            android:exported="false"
            android:label="@string/filter_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/filter_service_config" />
        </service>

        <service
            android:name=".block.BlockService"
            android:exported="false"
            android:label="@string/block_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/block_service_config" />
        </service>

        <receiver
            android:name=".block.ScheduleAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".filter.CaptureStopReceiver"
            android:exported="false" />
    </application>

</manifest>
